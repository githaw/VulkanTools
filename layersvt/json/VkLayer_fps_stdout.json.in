{
    "file_format_version": "1.0.0",
    "layer": {
        "name": "VK_LAYER_LUNARG_fps_stdout",
        "type": "GLOBAL",
        "library_path": "@JSON_LIBRARY_PATH@",
        "api_version": "@JSON_VERSION@",
        "implementation_version": "1",
        "description": "FPS Stdout Layer",
        "introduction": "The fps stdout utility layer prints the real-time frame rate in frames-per-second to stdout.",
        "url": "https://vulkan.lunarg.com/doc/sdk/latest/windows/layer_configuration.html",
        "platforms": [ "WINDOWS", "LINUX", "MACOS", "ANDROID" ],
        "instance_extensions": [
            {
                "name": "VK_EXT_layer_settings",
                "spec_version": "2"
            }
        ],
        "device_extensions": [
            {
                "name": "VK_EXT_tooling_info",
                "spec_version": "1",
                "entrypoints": [
                    "vkGetPhysicalDeviceToolPropertiesEXT"
                ]
            }
        ]
    }
}
